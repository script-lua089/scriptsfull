local function run(url)
    task.spawn(function()
        local ok, src = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and src then
            local f, err = loadstring(src)
            if f then
                pcall(f)
            else
                warn(err)
            end
        else
            warn("\078\111\032\115\101\032\112\117\100\111\032\111\098\116\101\110\101\114\058\032"..url)
        end
    end)
end
